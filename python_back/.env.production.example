# NMED Python analysis API production environment
# Nusxa oling: cp .env.production.example .env
# Python backend config.py aynan python_back/.env faylini o'qiydi.

OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o

# Agar ishlatilsa to'ldiring, aks holda bo'sh qoldirish mumkin.
ANTHROPIC_API_KEY=

DATABASE_URL=postgresql://nmed_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/med_helper_data

# .NET backenddagi Jwt__Key bilan AYNAN bir xil bo'lishi shart.
JWT_SECRET=CHANGE_ME_64_PLUS_RANDOM_CHARS

# Python API frontenddan emas, asosan .NET proxydan chaqiriladi.
ALLOWED_ORIGINS=https://nmed.uz,https://api.nmed.uz

# ── Tibbiy fayllarni saqlash (T-099) ─────────────────────────────────────
# Bemor fayllari loyiha papkasi ICHIDA saqlanmasligi kerak: `rsync --delete`
# bilan yangilashda ular o'chib ketishi mumkin edi, hamda kod va ma'lumot
# zaxira nusxasi ajratilmagan edi.
# .NET xizmati ham AYNI SHU papkani ko'rsatishi shart (Storage__UploadsRoot).
# Bo'sh qoldirilsa eski joy (python_back/uploads) ishlatiladi.
STORAGE_ROOT=/var/lib/nmed/storage
