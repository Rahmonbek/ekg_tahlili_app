# OpenAI kaliti (EKG, Lab, Holter, SMAD uchun majburiy)
OPENAI_API_KEY=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

# Ishlatilayotgan OpenAI modeli
